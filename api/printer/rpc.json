                "Content-Type": "application/json"
            },
            "url": "/api/printer/makePDF",
            "param": [
                {
                    "name": "paperWidth",
                    "type": "number",
                    "description": "纸张宽度"
                },
                {
                    "name": "paperHeight",
                    "type": "number",
                    "description": "纸张高度"
                },
                {
                    "name": "textArr",
                    "type": "array",
                    "description": "文本数组"
                },
                {
                    "name": "textStyle",
                    "type": "object",
                    "description": "文本样式"
                },
                {
                    "name": "tableColumnArr",
                    "type": "array",
                    "description": "表格列数组"
                },
                {
                    "name": "tableRowArr",
                    "type": "array",
                    "description": "表格行数组"
                },
                {
                    "name": "tableStyle",
                    "type": "object",
                    "description": "表格样式"
                },
                {
                    "name": "tableConfig",
                    "type": "object",
