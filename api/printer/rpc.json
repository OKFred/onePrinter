                },
                {
                    "name": "dashArr",
                    "type": "array",
                    "description": "虚线数组"
                },
                {
                    "name": "dashStyle",
                    "type": "object",
                    "description": "虚线样式"
                },
                {
                    "name": "mixinArr",
                    "type": "array",
                    "description": ""
                }
            ]
        },
        "response": {
            "data": {}
        },
        "info": {
            "name": "制作PDF",
            "tag": "制作"
        }
    },
    {
        "request": {
            "handlers": ["theUploader.onUpload"],
            "method": "POST",
            "headers": {
                "Content-Type": "multipart/form-data"
            },
            "url": "/api/printer/uploadPDF",
            "param": [
                {
                    "name": "files",
                    "type": "string",
                    "format": "binary",
                    "required": true,
                    "description": "PDF文件"
                }
            ]
        },
        "response": {
            "data": {}
        },
        "info": {
            "name": "上传PDF",
            "tag": "打印"
        }
    },
    {
        "request": {
            "handlers": ["theUSBPrinter.onPrintPDF"],
            "method": "POST",
            "headers": {
                "Content-Type": "application/json"
            },
            "url": "/api/printer/printPDF",
            "param": [
                {
                    "name": "relativePath",
                    "type": "string",
                    "required": true,
                    "description": "PDF的相对路径",
                    "examples": ["/api/printer/public/xxx.pdf"]
                }
            ]
        },
        "response": {
            "data": {}
        },
        "info": {
            "name": "打印PDF",
            "tag": "打印"
        }
